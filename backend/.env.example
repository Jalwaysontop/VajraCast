# Copy to .env (read from the directory the server is started in). All keys are optional.

NOWCAST_MODEL_PATH=../ml/artifacts/models/nowcast/latest
NOWCAST_DEVICE=auto                 # auto | cpu | cuda | mps
NOWCAST_DATA_DIR=var                # observation snapshots, forecasts, warnings.sqlite3

NOWCAST_HOST=127.0.0.1
NOWCAST_PORT=8000
# NOWCAST_API_KEY=change-me         # set it: write endpoints then require the X-API-Key header
NOWCAST_CORS_ORIGINS=["http://localhost:5173"]
NOWCAST_PUBLIC_URL=http://127.0.0.1:8000

# Where frames come from besides HTTP pushes: none | watch | replay
NOWCAST_SOURCE=none
# NOWCAST_SOURCE_PATH=/data/live    # watch: directory of <domain>.zarr   replay: one event .zarr
NOWCAST_POLL_SECONDS=30
NOWCAST_CLOCK=wall                  # use "data" when replaying archived events

# Operator console (web/): district boundaries, evaluation report, which domain it shows
# NOWCAST_REGIONS_PATH=../web/src/assets/geo/odisha_districts.json
# NOWCAST_SKILL_REPORT_PATH=var/demo/report/metrics.json
NOWCAST_CONSOLE_DOMAIN=odisha

# Products (nested keys use a double underscore)
NOWCAST_CELLS__THRESHOLD_DBZ=35
NOWCAST_WARNINGS__LIGHTNING_PROB=[0.3,0.5,0.7]
NOWCAST_WARNINGS__THUNDERSTORM_DBZ=[40,50,60]
NOWCAST_CAP__SENDER=nowcast@example.invalid
NOWCAST_CAP__STATUS=Test            # switch to Actual only after verification on real data
# NOWCAST_WEBHOOK_URL=https://example.invalid/hooks/warnings
