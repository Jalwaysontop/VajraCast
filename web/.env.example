# Data source: "api" connects to the FastAPI backend (../backend),
# "mock" uses the procedural mock generator (offline-capable, no backend needed)
VITE_DATA_SOURCE=api

# Base URL of the backend's console API (only used when VITE_DATA_SOURCE=api)
VITE_API_BASE_URL=http://localhost:8000/api/v1/console

# WebSocket URL for live ticks (only used when VITE_DATA_SOURCE=api)
VITE_WS_URL=ws://localhost:8000/api/v1/console/live
